build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.json
*.gch

# =========================================================================
# Compiled Binaries and Objects
# =========================================================================
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out

# =========================================================================
# Generated Source Files (Qt Meta-Object System)
# =========================================================================
# These are generated automatically during compiling. Do not track them.
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# Compiled translation binaries
*.qm
